;; -*- mode: scheme; -*-

(channel
 (version 0)
 (directory "src")
 (news-file "news.scm")
 ;; Only real, non-guix dependency: nonguix provides the multiarch-container
 ;; mechanism and the binary build system used by every package here.  guix
 ;; itself must NOT be listed as a dependency — it is the implicit base channel,
 ;; and declaring it makes dependency resolution fail; the consumer pins guix in
 ;; their own channels.scm.
 (dependencies
  (channel
   ;; NB: read as data, so the name is an UNQUOTED symbol here — `(name
   ;; 'nonguix)' would parse as the list (quote nonguix) and break dependency
   ;; resolution.
   (name nonguix)
   (url "https://gitlab.com/nonguix/nonguix")
   ;; bumped 2026-08-24: 4bc86c6 (2026-07) went stale against current guix
   ;; HEAD -- guix pruned the linux-libre-7.0 binding nonguix's checkout at
   ;; that commit still referenced, breaking cuirass's `nonguix' checkout
   ;; step for this spec ("Unbound variable: linux-libre-7.0"). caa8c0b is
   ;; what cuirass's own (unpinned) `nonguix' spec resolves to right now
   ;; and builds clean against the same guix commit.
   (commit "caa8c0b4646b993537be13c9bc819b3df68ab9b2")
   ;; NB: inside .guix-channel an introduction is the static
   ;; `channel-introduction' record — NOT `make-channel-introduction' (that is
   ;; the form for a channels.scm).
   (introduction
    (channel-introduction
     (version 0)
     (commit "897c1a470da759236cc11798f4e0a5f7d4d59fbc")
     (signer "2A39 3FFF 68F4 EF7A 3D29  12AF 6F51 20A0 22FB B2D5"))))))
